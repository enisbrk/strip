    <item>
      <title>Version 1.3.0</title>
      <pubDate>Thu, 15 Oct 2026 22:09:41 +0300</pubDate>
      <sparkle:version>5</sparkle:version>
      <sparkle:shortVersionString>1.3.0</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>13.0</sparkle:minimumSystemVersion>
      <description><![CDATA[<p>Close a window and the windows left on its screen now widen to fill it, instead of the next screen's windows sliding in. Turn it off in Settings → Layout. The Center column command was removed; ⌃⌥C still centers a window on its own screen.</p>]]></description>
      <enclosure url="https://github.com/enisbrk/strip/releases/download/v1.3.0/Strip-1.3.0.dmg" type="application/octet-stream" sparkle:edSignature="EG5+CZz1f2GOe5oE4aC6ggDVu32jI7nuYxG22fE+aYUI8EBi2naQ6+jB4cjj7lZ3Pk7XLzsWM25DHFyhhz8oDA==" length="7980750"/>
    </item>
    <item>
      <title>Version 1.2.0</title>
      <pubDate>Thu, 15 Oct 2026 21:01:17 +0300</pubDate>
      <sparkle:version>4</sparkle:version>
      <sparkle:shortVersionString>1.2.0</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>13.0</sparkle:minimumSystemVersion>
      <description><![CDATA[<p>New Edit strip (⌃⌥O): a ⌘Tab-like glass panel over your bare desktop, each screen a miniature display; drag windows or whole screens, pick with the arrow keys and Return. Each screen now takes a full screen width, so the next screen's windows never peek in. Drag a window to a screen edge or corner to snap it into a half or a quarter. Layout presets were removed: Strip always runs as a strip.</p>]]></description>
      <enclosure url="https://github.com/enisbrk/strip/releases/download/v1.2.0/Strip-1.2.0.dmg" type="application/octet-stream" sparkle:edSignature="e6nVrPuwTUILNXZ2fKP9vXrsLWx4iQo7sQWqh/jdFQv8kkuLxmQ9ZLYdaxKWgZcAywnU8YTjsxgBb2ghs8IWAQ==" length="7981901"/>
    </item>
    <item>
      <title>Version 1.1.1</title>
      <pubDate>Tue, 13 Oct 2026 14:22:57 +0300</pubDate>
      <sparkle:version>3</sparkle:version>
      <sparkle:shortVersionString>1.1.1</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>13.0</sparkle:minimumSystemVersion>
      <description><![CDATA[<p>Edit strip (⌃⌥O): drag a window between screens or onto the New screen slot to give it a screen of its own, and turn a stack into windows side by side. New About Strip window in the menu.</p>]]></description>
      <enclosure url="https://github.com/enisbrk/strip/releases/download/v1.1.1/Strip-1.1.1.dmg" type="application/octet-stream" sparkle:edSignature="OBG0tCG4raniDwZycdccUK+j45Y2eGgfIvZb0Ln7C0e7a69ZSC1XKhHcA/BM0Y9gKbpUeT+UgGkYY+Qi1wTCDw==" length="7876877"/>
    </item>
    <item>
      <title>Version 1.1.0</title>
      <pubDate>Tue, 13 Oct 2026 12:50:42 +0300</pubDate>
      <sparkle:version>2</sparkle:version>
      <sparkle:shortVersionString>1.1.0</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>13.0</sparkle:minimumSystemVersion>
      <description><![CDATA[<p>New Edit strip view (⌃⌥O) to reorder, stack, resize and center windows with live previews; drop a window onto another to share its screen; center a column on its own screen with margins (⌃⌥C); app icons in the minimap; minimized windows return to their place; Wi-Fi sign-in sheets stay on top.</p>]]></description>
      <enclosure url="https://github.com/enisbrk/strip/releases/download/v1.1.0/Strip-1.1.0.dmg" type="application/octet-stream" sparkle:edSignature="rTAaC5wp1NQebe5JixY7uKohcMtMvImA/8BVKmMhpAfuy9ouatY05S/cwsMQu04J0mSN/G+ZSF9gpY5Bk2SOAw==" length="7833965"/>
